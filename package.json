{
  "name": "spicetify-websocket-client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "spicetify-creator && spicetify apply",
    "build": "spicetify-creator",
    "build-local": "spicetify-creator --out=dist --minify",
    "watch": "spicetify-creator --watch",
    "build-standalone": "node scripts/build-standalone.mts --minify",
    "package": "node scripts/build-dist.mts",
    "build-go": "node scripts/build-go.mts",
    "dev": "node host/index.mts",
    "host": "node host/index.mts",
    "typecheck": "tsc --noEmit && tsc -p host && tsc -p scripts",
    "host:exe": "node scripts/host-exe.mts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pubsub-js": "^1.8.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "spicetify-creator": "^1.0.17",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pubsub-js": "^1.9.5",
    "react": "^19.2.4",
    "spcr-settings": "^1.3.1",
    "ws": "^8.21.2"
  }
}
